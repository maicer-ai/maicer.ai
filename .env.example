# Secure cloud asset manifest used by the first-run provisioning flow.
VOICE_CODE_ASSET_MANIFEST_URL=

# Optional direct fallback values for local testing when the manifest is unavailable.
WHISPER_DOWNLOAD_URL=https://github.com/ggerganov/whisper.cpp/releases/download/v1.7.4/whisper-bin-x64.zip
WHISPER_SHA256=replace-with-published-sha256
QWEN_MODEL_DOWNLOAD_URL=https://huggingface.co/bartowski/Qwen2.5-Coder-0.5B-Instruct-GGUF/resolve/main/Qwen2.5-Coder-0.5B-Instruct-Q4_K_M.gguf?download=true
QWEN_MODEL_SHA256=replace-with-published-sha256

# Optional: only used when Ollama is not already installed.
OLLAMA_INSTALLER_URL=https://ollama.com/download/OllamaSetup.exe
OLLAMA_INSTALLER_SHA256=replace-with-published-sha256

# Supabase public client settings used by the Premium waitlist form.
# Use the project URL and publishable/anon key only; never use a service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key